{
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "name": "cedric-ruiu-fr",
  "description": "Site vitrine de Cédric Ruiu, développeur web indépendant",
  "repository": "https://github.com/Cedric-ruiu/cedric-ruiu.fr.git",
  "author": "Cédric Ruiu",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "assets": "node scripts/copy-fonts.mjs && node scripts/build-js.mjs && node scripts/build-images.mjs",
    "dev": "yarn assets && eleventy --serve",
    "build": "node scripts/clean.mjs && yarn assets && eleventy",
    "lint": "biome check .",
    "format": "biome format --write . && biome check . --write"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@biomejs/biome": "^2.5.8",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.50.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "yarn@4.13.0"
}
