{% import "partials/logo.njk" as logoPartial with context %}
{% import "partials/icons.njk" as iconPartial with context %}

<footer class="safe-x on-dark border-t border-foam/12 bg-seabed">
  <div class="wrap pt-16 pb-10 lg:pt-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-5">
        <a href="/" class="tap" aria-label="{{ site.name }}, accueil">
          {{ logoPartial.logo(variant="default", size=56, alt="", class="text-foam") }}
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-on-water-muted">Développeur web indépendant à Séné, dans le Morbihan. Création de sites internet, référencement SEO et performance web, en Bretagne et partout en France.</p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="text-sm font-semibold text-on-water-muted">Contact</div>
        <ul class="text-lead mt-2 flex flex-col font-semibold text-foam">
          <li><a href="mailto:{{ site.email }}" data-umami-event="email" data-umami-event-emplacement="pied-de-page" class="tap w-fit"><span class="link-underline">{{ site.email }}</span></a></li>
          <li><a href="tel:{{ site.phone | phoneE164 }}" data-umami-event="appel" data-umami-event-emplacement="pied-de-page" class="tap w-fit"><span class="link-underline">{{ site.phone | phoneDisplay }}</span></a></li>
          <li class="flex min-h-11 items-center font-normal text-on-water">{{ site.locality }}, {{ site.department }} ({{ site.departmentCode }})</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 grid gap-8 border-t border-foam/12 pt-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-5">
        <div class="text-sm font-semibold text-on-water-muted">Pages</div>
        <ul class="mt-2 flex flex-col text-on-water [&>li+li]:-mt-3">
          {% for item in site.nav %}
          {% if not item.service %}
          <li><a href="{{ item.url }}" class="tap w-fit"><span class="link-underline">{{ item.name }}</span></a></li>
          {% endif %}
          {% endfor %}
          <li><a href="/etre-visible-sur-google/" class="tap w-fit"><span class="link-underline">Être visible sur Google</span></a></li>
          <li><a href="/mentions-legales/" class="tap w-fit"><span class="link-underline">Mentions légales</span></a></li>
        </ul>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="text-sm font-semibold text-on-water-muted">Expertise</div>
        <ul class="mt-2 flex flex-col text-on-water [&>li+li]:-mt-3">
          {% for service in services %}
          <li><a href="{{ service.url }}" class="tap w-fit" {% if page.url == service.url %}aria-current="page"{% endif %}><span class="link-underline">{{ service.name }}</span></a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-foam/12">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3 text-sm text-on-water-subtle">
      <p class="flex flex-wrap gap-x-6 gap-y-1">
        <span>© {% year %} {{ site.name }}</span>
        <span>{{ site.baselineShort }}</span>
      </p>
      <a href="{{ site.repository }}" class="tap gap-2 text-on-water-subtle hover:text-on-water">
        {{ iconPartial.icon("github", class="h-4 w-4 shrink-0") }}
        Code source
      </a>
    </div>
  </div>
</footer>
