<figure class="my-12 rounded-2xl border border-border bg-surface p-5 sm:p-8">
  <dl class="grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6">
    <div class="flex flex-col-reverse justify-end gap-1">
      <dt class="text-sm leading-snug text-muted">Affichage (LCP)<br>objectif : 2,5 s ou moins</dt>
      <dd class="text-section text-ocean">{{ vitals.lcp }}</dd>
    </div>
    <div class="flex flex-col-reverse justify-end gap-1">
      <dt class="text-sm leading-snug text-muted">Stabilité (CLS)<br>objectif : 0,1 ou moins</dt>
      <dd class="text-section text-ocean">{{ vitals.cls }}</dd>
    </div>
    <div class="flex flex-col-reverse justify-end gap-1">
      <dt class="text-sm leading-snug text-muted">Réactivité : temps de blocage<br>objectif : le plus bas possible</dt>
      <dd class="text-section text-ocean">{{ vitals.tbt }}</dd>
    </div>
  </dl>
  <figcaption class="mt-6 border-t border-border pt-4 text-sm leading-relaxed text-muted">Page d'accueil de ce site, mesurée avec Lighthouse le {{ vitals.measured }}, en simulant un téléphone moyen sur une connexion 4G lente.</figcaption>
</figure>
