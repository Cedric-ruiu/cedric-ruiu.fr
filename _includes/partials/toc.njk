<div class="hidden xl:col-span-5 xl:col-start-8 xl:block">
  <nav class="sticky top-[calc(var(--header-h)+2rem)]" aria-label="Sur cette page">
    <p class="text-sm font-semibold text-muted">Sur cette page</p>
    <ul class="mt-3 border-l border-border text-[0.9375rem] leading-snug">
      {% for heading in toc %}
      <li class="-ml-px border-l-2 border-transparent py-1.5 pl-4 has-[a:hover]:border-ocean"><a href="#{{ heading.id }}" class="text-copy hover:text-ink">{{ heading.text }}</a></li>
      {% endfor %}
      {% if faq %}
      <li class="-ml-px border-l-2 border-transparent py-1.5 pl-4 has-[a:hover]:border-ocean"><a href="#faq-title" class="text-copy hover:text-ink">Questions fréquentes</a></li>
      {% endif %}
    </ul>
  </nav>
</div>
