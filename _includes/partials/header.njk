{% import "partials/logo.njk" as logoPartial with context %}

<header class="safe-x on-dark fixed inset-x-0 top-0 z-40 pt-3">
  <div class="wrap">
  <div class="-mx-2 flex h-14 items-center justify-between rounded-full {% if drenched %}bg-abyss/40 ring-foam/20{% else %}bg-abyss/90 ring-foam/10{% endif %} pr-1 pl-3 ring-1 backdrop-blur-md sm:-mx-4 sm:pl-4 lg:-mx-5 lg:pr-3 lg:pl-5">
    <a href="/" class="tap shrink-0" aria-label="{{ site.name }}, accueil">
      {{ logoPartial.logo(variant="default", size=36, alt="", class="text-foam") }}
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-1 lg:gap-2" data-nav-list>
        {% for item in site.nav | navLinks(services) %}
        <li>
          <a
            href="{{ item.url }}"
            class="nav-link tap relative px-3 text-[0.9375rem] font-semibold {% if page.url == item.url %}text-foam{% else %}text-on-water hover:text-foam{% endif %}"
            {% if page.url == item.url %}aria-current="page"{% endif %}
          >{{ item.name }}{% if page.url == item.url %}<span class="nav-mark" aria-hidden="true"></span>{% endif %}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="flex items-center gap-1 md:hidden">
      <a
        href="tel:{{ site.phone | phoneE164 }}"
        data-umami-event="appel"
        data-umami-event-emplacement="en-tete"
        class="flex h-11 w-11 items-center justify-center rounded-full text-foam"
        aria-label="Appeler le {{ site.phone | phoneDisplay }}"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </a>

      <div class="h-11 w-11">
        <button
          type="button"
          id="nav-toggle"
          class="flex h-11 w-11 items-center justify-center rounded-full text-foam md:hidden"
          aria-expanded="false"
          aria-controls="nav-mobile"
          aria-label="Ouvrir le menu"
          hidden
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
  </div>

  <div
    id="nav-mobile"
    class="menu-sheet safe-all fixed inset-0 z-50 flex flex-col bg-abyss"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    hidden
  >
    <div class="wrap pt-3">
    <div class="-mx-2 flex h-14 items-center justify-between pr-1 pl-3 sm:-mx-4 sm:pl-4">
      <a href="/" class="tap shrink-0" aria-label="{{ site.name }}, accueil">
        {{ logoPartial.logo(variant="default", size=36, alt="", class="text-foam") }}
      </a>
      <button
        type="button"
        id="nav-close"
        class="flex h-11 w-11 items-center justify-center rounded-full text-foam"
        aria-label="Fermer le menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
    </div>

    <nav aria-label="Navigation mobile" class="flex flex-1 flex-col justify-center px-8 pb-20">
      <ul class="flex flex-col gap-2">
        {% for item in site.nav | navLinks(services) %}
        <li class="menu-rise">
          <a
            href="{{ item.url }}"
            class="block py-3 text-3xl font-light tracking-[-0.02em] {% if page.url == item.url %}text-foam{% else %}text-on-water{% endif %}"
            {% if page.url == item.url %}aria-current="page"{% endif %}
          >{{ item.name }}</a>
        </li>
        {% endfor %}
      </ul>
      <a href="/contact/" class="menu-rise btn-primary mt-10 [--i:6]">Me contacter</a>
    </nav>
  </div>
</header>
