{# Logos are inlined, never <img>: currentColor would resolve to black inside an
   image. #}
{% macro logo(variant="default", size=40, alt=None, class="", id="") %}
{%- set v = logos[variant] -%}
{%- set width = (size * v.ratio) | round -%}
{%- set name = alt if alt != None else (site.name if v.hasText else "") -%}
<svg viewBox="{{ v.viewBox }}" width="{{ width }}" height="{{ size }}" fill="currentColor"{% if class %} class="{{ class }}"{% endif %}{% if name %} role="img" aria-label="{{ name }}"{% else %} aria-hidden="true"{% endif %}>{% if id %}<g id="{{ id }}">{{ v.body | safe }}</g>{% else %}{{ v.body | safe }}{% endif %}</svg>
{%- endmacro %}

{% macro reuse(id, variant="mark", size=40, class="") %}
{%- set v = logos[variant] -%}
<svg viewBox="{{ v.viewBox }}" width="{{ (size * v.ratio) | round }}" height="{{ size }}" fill="currentColor"{% if class %} class="{{ class }}"{% endif %} aria-hidden="true"><use href="#{{ id }}"></use></svg>
{%- endmacro %}
