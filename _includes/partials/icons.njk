{#
  Usage: {{ iconPartial.icon("seo", class="h-14 w-14 text-ocean") }}
  `class` is written in full at each call site so the Tailwind scanner can see it —
  never assembled from `name`, which is matched by an explicit test instead.
#}
{% macro icon(name, class="") %}
{%- if name == "site" -%}
<svg viewBox="0 0 48 48" fill="currentColor"{% if class %} class="{{ class }}"{% endif %} aria-hidden="true">
  <rect x="8.5" y="9" width="31" height="30" rx="4.5" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path d="M8.5 17.5h31" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <ellipse cx="13.9" cy="13.25" rx="2.1" ry="1.65" transform="rotate(-18 13.9 13.25)"/>
  <ellipse cx="19.4" cy="13.25" rx="1.9" ry="1.5" transform="rotate(-18 19.4 13.25)"/>
  <ellipse cx="17.5" cy="28.2" rx="4.4" ry="3.7" transform="rotate(-22 17.5 28.2)"/>
  <path d="M25 25.6h9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M25 30.8h6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
</svg>
{%- elif name == "seo" -%}
<svg viewBox="0 0 48 48" fill="currentColor"{% if class %} class="{{ class }}"{% endif %} aria-hidden="true">
  <circle cx="20" cy="20" r="11.5" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path d="M28.6 28.6 39 39" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <ellipse cx="14.6" cy="24.6" rx="2.2" ry="1.75" transform="rotate(18 14.6 24.6)"/>
  <ellipse cx="20.2" cy="21" rx="2.55" ry="2" transform="rotate(-28 20.2 21)"/>
  <ellipse cx="25.7" cy="16.3" rx="2.9" ry="2.25" transform="rotate(-42 25.7 16.3)"/>
</svg>
{%- elif name == "github" -%}
{#- Official GitHub mark, 16px grid — sized down at the call site, not redrawn. -#}
<svg viewBox="0 0 16 16" fill="currentColor"{% if class %} class="{{ class }}"{% endif %} aria-hidden="true">
  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
</svg>
{%- elif name == "perf" -%}
<svg viewBox="0 0 48 48" fill="currentColor"{% if class %} class="{{ class }}"{% endif %} aria-hidden="true">
  <path d="M8 32A16 16 0 0 1 40 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <circle cx="24" cy="32" r="2.5"/>
  <path d="M24 32C25.5 29.4 27.1 27.2 28.8 25.3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <ellipse cx="30.6" cy="23.4" rx="2.7" ry="2.1" transform="rotate(-45 30.6 23.4)"/>
  <ellipse cx="13.05" cy="29.67" rx="1.85" ry="1.5" transform="rotate(15 13.05 29.67)"/>
  <ellipse cx="16.51" cy="23.68" rx="2.15" ry="1.7" transform="rotate(-20 16.51 23.68)"/>
</svg>
{%- endif -%}
{% endmacro %}
