---
layout: base
---

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
  {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
  <h1 class="text-h1 mt-3 font-serif">{{ heading }}</h1>
  {% if lead %}<p class="text-body mt-5 text-muted">{{ lead }}</p>{% endif %}

  <div class="prose-site mt-8">
    {{ content | safe }}
  </div>

  {% if actions %}
  <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4">
    {% for action in actions %}
    <a href="{{ action.url }}" class="{% if loop.first %}btn-primary{% else %}btn-secondary{% endif %} w-full sm:w-auto">{{ action.label }}</a>
    {% endfor %}
  </div>
  {% endif %}
</section>
