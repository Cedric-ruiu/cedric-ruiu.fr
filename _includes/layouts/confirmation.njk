---
layout: base
---

<section class="surface scene on-dark relative isolate flex min-h-svh flex-col overflow-hidden" aria-labelledby="page-title" data-scene>
  {% include "partials/surface-kelp.njk" %}
  <div class="wrap flex flex-1 flex-col pt-[calc(var(--header-h)+2.5rem)] pb-24 sm:pt-[calc(var(--header-h)+5rem)] lg:justify-center lg:pt-[calc(var(--header-h)+3rem)]">
    {% if check %}
    <svg class="rise mb-8 h-12 w-12 text-foam" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12.5 9.5 18 20 6.5"></path>
    </svg>
    {% endif %}
    <h1 id="page-title" class="rise text-display max-w-[16ch] text-foam [--i:1]">{{ heading }}</h1>
    <div class="rise text-lead mt-6 max-w-[56ch] [--i:2] [&_a]:font-semibold [&_a]:text-foam [&_a]:underline [&_a]:underline-offset-[0.2em] [&_p+p]:mt-4">
      {{ content | safe }}
    </div>

    {% if actions %}
    <div class="rise mt-10 flex flex-col gap-3 [--i:3] sm:flex-row sm:gap-4">
      {% for action in actions %}
      <a href="{{ action.url }}" class="{% if loop.first %}btn-primary{% else %}btn-secondary{% endif %} w-full sm:w-auto">{{ action.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
