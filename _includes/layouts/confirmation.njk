---
layout: base
---

{# Own layout rather than page.njk: reuses the contact form's tide card so the confirmation reads as its answer. #}
<section class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="rounded border border-border bg-tide p-6 text-center sm:p-10">
    {# aria-hidden: the heading already states the outcome, no need to announce it twice. #}
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-ocean text-white" aria-hidden="true">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12.5 9.5 18 20 6.5"></path>
      </svg>
    </span>

    <p class="eyebrow mt-6">{{ eyebrow }}</p>
    <h1 class="text-h1 mt-3 font-serif">{{ heading }}</h1>

    <div class="prose-site mx-auto mt-5">
      {{ content | safe }}
    </div>

    {% if actions %}
    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center sm:gap-4">
      {% for action in actions %}
      <a href="{{ action.url }}" class="{% if loop.first %}btn-primary{% else %}btn-secondary{% endif %} w-full sm:w-auto">{{ action.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
