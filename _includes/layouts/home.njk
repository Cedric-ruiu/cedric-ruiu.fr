---
layout: base
---
{% import "partials/logo.njk" as logoPartial with context %}
{% import "partials/icons.njk" as iconPartial %}

<div class="dive on-dark">

<section class="scene relative isolate flex min-h-svh flex-col overflow-hidden" data-scene>
  {# Keep the three frond <svg> adjacent: gzip then stores each copy after the
     first in ~150 bytes instead of 8.5 kB. #}
  <div class="kelp-forest pointer-events-none absolute inset-0 -z-10 select-none" aria-hidden="true">
    <div class="kelp kelp-far absolute -bottom-16 -left-44 text-abyss opacity-45 sm:-left-32 lg:-bottom-32 lg:-left-40">
      {{ logoPartial.logo(variant="mark", size=520, alt="", class="kelp-blade h-[38rem] w-auto lg:h-[60rem]") }}
    </div>
    <div class="kelp kelp-mid absolute right-[22%] -bottom-24 hidden text-ocean-deep opacity-70 lg:block">
      {{ logoPartial.logo(variant="mark", size=520, alt="", class="kelp-blade h-[40rem] w-auto") }}
    </div>
    <div class="kelp absolute -right-28 -bottom-20 text-foam opacity-20 sm:-right-16 lg:-right-10 lg:-bottom-24">
      {{ logoPartial.logo(variant="mark", size=520, alt="", class="kelp-blade h-[28rem] w-auto sm:h-[34rem] lg:h-[50rem]") }}
    </div>

    <span class="bubble bubble-1"></span>
    <span class="bubble bubble-2"></span>
    <span class="bubble bubble-3"></span>
    <span class="bubble bubble-4"></span>
    <span class="bubble bubble-5"></span>
    <span class="bubble bubble-6"></span>
    <span class="bubble bubble-7 hidden lg:block"></span>
    <span class="bubble bubble-8 hidden lg:block"></span>
    <span class="bubble bubble-9 hidden lg:block"></span>
    <span class="bubble bubble-10 hidden lg:block"></span>
    <span class="bubble bubble-11 hidden lg:block"></span>
    <span class="bubble bubble-12 hidden lg:block"></span>
  </div>

  <div class="wrap flex flex-1 flex-col pt-[calc(var(--header-h)+1.5rem)] pb-28 sm:pt-[calc(var(--header-h)+3rem)] lg:justify-end lg:pt-[calc(var(--header-h)+2.5rem)] lg:pb-16">
    {{ logoPartial.logo(variant="full", size=128, class="rise mb-10 hidden text-foam lg:block") }}
    <h1 class="rise text-display-s max-w-[24ch] text-foam [--i:1]">{{ home.hero.title }}</h1>
    <p class="rise text-lead mt-4 font-semibold text-foam [--i:1] lg:mt-5">{% for item in home.hero.services.split(" · ") %}<span class="whitespace-nowrap">{{ item }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    <p class="rise text-body mt-5 max-w-[58ch] [--i:2] lg:mt-8">{{ home.hero.intro }}</p>

    <div class="rise mt-8 flex flex-col gap-3 [--i:3] sm:flex-row sm:flex-wrap sm:items-center sm:gap-4 lg:mt-10">
      <a href="tel:{{ site.phone | phoneE164 }}" data-umami-event="appel" data-umami-event-emplacement="heros" class="btn-primary w-full sm:w-auto">{{ iconPartial.icon("phone", class="h-5 w-5 shrink-0") }}Appeler&nbsp;le&nbsp;{{ site.phone | phoneDisplay }}</a>
      <a href="{{ home.hero.contact.url }}" class="btn-secondary w-full sm:w-auto">{{ home.hero.contact.label }}</a>
      <a href="{{ home.hero.projects.url }}" class="tap self-start sm:ml-2 sm:self-auto"><span class="link-plain">{{ home.hero.projects.label }}</span></a>
    </div>
  </div>

</section>

<section class="relative isolate overflow-hidden pt-6 pb-(--section-gap-l) lg:pt-[calc(var(--section-gap-l)-4rem)]" aria-labelledby="expertise-title" data-scene>
  <div class="kelp-forest pointer-events-none absolute inset-0 -z-10 select-none" aria-hidden="true">
    <div class="kelp kelp-far absolute -right-40 -bottom-24 text-ocean opacity-20 lg:right-[4%]">
      {{ logoPartial.logo(variant="mark", size=520, alt="", class="kelp-blade h-[44rem] w-auto lg:h-[64rem]") }}
    </div>
    <span class="bubble bubble-1"></span>
    <span class="bubble bubble-2"></span>
    <span class="bubble bubble-6 hidden lg:block"></span>
    <span class="bubble bubble-9 hidden lg:block"></span>
  </div>

  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-x-8">
      <h2 id="expertise-title" class="text-section text-foam lg:col-span-6">{{ home.expertise.title }}</h2>
      <p class="text-lead max-w-[52ch] lg:col-span-5 lg:col-start-8">{{ home.expertise.intro }}</p>
    </div>

    <div class="mt-12 grid gap-12 lg:mt-20 lg:grid-cols-3 lg:items-start lg:gap-x-12">
      {% for item in home.expertise.items %}
      {% set step = loop.index %}
      {% for service in services %}{% if service.key == item.service %}
      <article class="flex flex-col border-t border-foam/25 pt-6 {% if step == 2 %}lg:mt-20{% elif step == 3 %}lg:mt-40{% endif %}">
        <div class="flex items-center gap-4">
          {{ iconPartial.icon(service.icon, class="-ml-1.5 h-12 w-12 shrink-0 text-foam") }}
          <h3 class="text-title text-foam">{{ item.title }}</h3>
        </div>
        <p class="text-lead mt-5">{{ item.text }}</p>
        {% if item.related %}
        <p class="text-lead mt-3">Voir aussi :
          {% for key in item.related %}{% for other in services %}{% if other.key == key %}<a href="{{ other.url }}" class="link-plain">{{ other.title }}</a>{% endif %}{% endfor %}{% if not loop.last %} et {% endif %}{% endfor %}
        </p>
        {% endif %}
        <p class="mt-auto pt-6">
          <a href="{{ service.url }}" class="tap"><span class="link-plain">{{ item.link }}</span></a>
        </p>
      </article>
      {% endif %}{% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<section aria-labelledby="why-title">
  <div class="wrap">
    <h2 id="why-title" class="text-display-s max-w-[22ch] text-foam">{{ home.why.title }}</h2>

    <div class="mt-12 grid gap-10 lg:mt-20 lg:grid-cols-12 lg:gap-x-8">
      <div class="sm:max-w-sm lg:col-span-5 lg:-ml-[calc(var(--gutter)+max(0px,(100vw-var(--container))/2))] lg:max-w-none">
        <div class="relative aspect-[600/406] overflow-hidden rounded-panel sm:aspect-[787/1000] lg:aspect-auto lg:h-full lg:min-h-[36rem] lg:rounded-l-none">
          <picture>
            <source media="(min-width: 640px)" srcset="{{ home.why.photo.portrait }} 787w, {{ home.why.photo.portraitLarge }} 1559w" sizes="(min-width: 1024px) 40rem, 24rem">
            <img src="{{ home.why.photo.landscape }}" width="600" height="406" alt="{{ home.why.photo.alt }}" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover object-[50%_25%]">
          </picture>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-lead text-foam">{{ home.why.intro }}</p>
        <dl class="mt-10 flex flex-col">
          {% for item in home.why.items %}
          <div class="border-t border-foam/20 py-7 last:pb-0">
            <dt class="text-title text-foam">{{ item.title }}</dt>
            <dd class="text-lead mt-3">{{ item.text }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="relative isolate overflow-hidden pt-(--section-gap-l) pb-(--section-gap-l) text-center" aria-labelledby="cta-title">
  <div class="pointer-events-none absolute inset-0 -z-10 hidden select-none sm:block" aria-hidden="true">
    <div class="absolute bottom-0 left-0 text-ocean-deep lg:left-[6%]">
      {{ logoPartial.logo(variant="mark", size=520, alt="", class="h-[20rem] w-auto lg:h-[30rem]") }}
    </div>
    <div class="absolute right-0 bottom-0 -scale-x-100 text-ocean-deep opacity-70 lg:right-[8%]">
      {{ logoPartial.logo(variant="mark", size=520, alt="", class="h-[16rem] w-auto lg:h-[24rem]") }}
    </div>
  </div>
  <div class="wrap">
    <h2 id="cta-title" class="text-display mx-auto text-foam">{{ home.cta.title }}</h2>
    <p class="text-lead mx-auto mt-6 max-w-[52ch]">{{ home.cta.text }}</p>
    <a href="{{ home.cta.button.url }}" class="btn-primary mt-10 w-full sm:w-auto">{{ home.cta.button.label }}</a>
  </div>
</section>

</div>

{{ content | safe }}
