---
layout: base
---
{% import "partials/logo.njk" as logoPartial with context %}

<section class="mx-auto max-w-6xl px-4 pt-12 pb-8 sm:px-6 sm:pt-16 lg:px-8">
  <p class="eyebrow">{{ eyebrow }}</p>
  <h1 class="text-h1 mt-3 font-serif">{{ heading }}</h1>
  <div class="text-body mt-5 max-w-2xl">{{ content | safe }}</div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8">
  <ul class="grid list-none grid-cols-1 gap-6 sm:grid-cols-[repeat(auto-fit,minmax(20rem,1fr))]">
    {% for project in projects %}
    <li class="flex">
      <article class="card flex w-full flex-col overflow-hidden">
        <a
          href="{{ project.url }}"
          target="_blank"
          rel="noopener"
          {# Focus ring drawn with a negative outline-offset: the card's overflow-hidden
             (needed to clip the thumbnail corners and hover zoom) would otherwise cut it off. #}
          class="group relative block aspect-16/10 w-full overflow-hidden bg-tide focus-visible:-outline-offset-4 focus-visible:shadow-none"
        >
          {% if project.image | hasImage %}
          {# `sizes` mirrors the grid tracks above (container max-w-6xl, gap 1.5rem, tracks
             minmax(20rem,1fr)) so the browser fetches the 480/640/800 rung that actually
             matches the rendered card width — verified at 286px/320w, 466px/1024w, 345px/1280w. #}
          {% responsiveImage project.image, project.imageAlt, { sizes: "(min-width: 1152px) 21.5rem, (min-width: 1072px) calc((100vw - 7rem) / 3), (min-width: 1024px) calc((100vw - 5.5rem) / 2), (min-width: 712px) calc((100vw - 4.5rem) / 2), (min-width: 640px) calc(100vw - 3rem), calc(100vw - 2rem)", className: "absolute inset-0 h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100", eager: loop.first } %}
          {% else %}
          <span class="absolute inset-0 flex items-center justify-center">
            {{ logoPartial.logo(variant="mark", size=56, alt="", class="text-ink opacity-15") }}
          </span>
          {% endif %}
          <span class="sr-only">Voir le site {{ project.name }} (nouvel onglet)</span>
        </a>

        <div class="flex flex-1 flex-col p-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="tag">{{ project.tag }}</span>
            {% if project.year %}<span class="text-sm text-muted">{{ project.year }}</span>{% endif %}
          </div>

          <h2 class="text-h3 mt-4 font-serif">{{ project.name }}</h2>
          <p class="text-body mt-3">{{ project.description }}</p>
          {% if project.stack %}<p class="mt-3 text-sm text-muted">{{ project.stack }}</p>{% endif %}

          <p class="mt-3">
            <a href="{{ project.url }}" target="_blank" rel="noopener" class="tap font-medium text-ocean">
              <span class="link-underline">Voir le site<span class="sr-only"> {{ project.name }} (nouvel onglet)</span>
                <span aria-hidden="true">→</span></span>
            </a>
          </p>
        </div>
      </article>
    </li>
    {% endfor %}
  </ul>
</section>
