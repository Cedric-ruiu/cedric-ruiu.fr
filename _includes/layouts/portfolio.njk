---
layout: base
---
{% import "partials/logo.njk" as logoPartial with context %}

<section class="surface scene on-dark relative isolate overflow-hidden" aria-labelledby="page-title" data-scene>
  {% include "partials/surface-kelp.njk" %}
  <div class="wrap pt-[calc(var(--header-h)+2rem)] pb-16 sm:pt-[calc(var(--header-h)+4rem)] sm:pb-20 lg:pt-[calc(var(--header-h)+4.5rem)] lg:pb-28">
    <h1 id="page-title" class="rise text-display-s max-w-[20ch] text-foam">{{ heading }}</h1>
    <div class="rise text-body mt-6 max-w-[60ch] [--i:1] lg:text-lead">{{ content | safe }}</div>
  </div>
</section>

<ul class="wrap flex list-none flex-col gap-(--section-gap-s) py-(--section-gap-s)">
  {% for project in projects %}
  <li>
    <article class="grid gap-6 lg:grid-cols-12 lg:items-center lg:gap-x-8">
      <a href="{{ project.url }}" target="_blank" rel="noopener" class="group relative block aspect-16/10 overflow-hidden rounded-2xl bg-paper-2 ring-1 ring-border lg:col-span-7">
        {% if project.image | hasImage %}
        {% responsiveImage project.image, project.imageAlt, { sizes: "(min-width: 1440px) 752px, (min-width: 1024px) calc(58.33vw - 88px), (min-width: 960px) calc(100vw - 128px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)", className: "absolute inset-0 h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100", eager: loop.first } %}
        {% else %}
        <span class="absolute inset-0 flex items-center justify-center">
          {{ logoPartial.reuse("kelp-shape", size=56, class="text-ink opacity-15") }}
        </span>
        {% endif %}
        <span class="sr-only">Voir le site {{ project.name }} (nouvel onglet)</span>
      </a>

      <div class="lg:col-span-5 lg:pl-4">
        <h2 class="text-heading">{{ project.name }}</h2>
        <p class="mt-2 flex flex-wrap gap-x-4 text-sm"><span class="text-copy">{{ project.tag }}</span>{% if project.year %}<span class="text-muted">{{ project.year }}</span>{% endif %}</p>
        <p class="text-body mt-5">{{ project.description }}</p>
        {% if project.stack %}<p class="mt-3 text-sm text-muted">{{ project.stack }}</p>{% endif %}

        <div class="mt-4 flex flex-wrap items-center gap-x-8">
          <a href="{{ project.url }}" target="_blank" rel="noopener" class="tap"><span class="link-plain">Voir le site<span class="sr-only"> {{ project.name }} (nouvel onglet)</span></span></a>
          {% for service in services %}{% if service.key == project.services[0] %}
          <p class="text-sm text-muted">
            Service :
            <a href="{{ service.url }}" class="tap font-semibold text-ocean"><span class="link-underline">{{ service.title }}</span></a>
          </p>
          {% endif %}{% endfor %}
        </div>
      </div>
    </article>
  </li>
  {% endfor %}
</ul>
