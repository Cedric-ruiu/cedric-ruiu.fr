---
layout: base
---
{% import "partials/icons.njk" as iconPartial %}
{% import "partials/logo.njk" as logoPartial with context %}

<section class="surface scene on-dark relative isolate overflow-hidden" aria-labelledby="page-title" data-scene>
  {% include "partials/surface-kelp.njk" %}
  <div class="wrap pt-[calc(var(--header-h)+2rem)] pb-16 sm:pt-[calc(var(--header-h)+4rem)] sm:pb-20 lg:pt-[calc(var(--header-h)+4.5rem)] lg:pb-28">
    <h1 id="page-title" class="rise text-display-s max-w-[24ch] text-foam [--i:1]">{{ heading }}</h1>
    <p class="rise text-body mt-6 max-w-[56ch] [--i:2] lg:text-lead">{{ lead }}</p>
    <div class="rise mt-8 flex flex-col gap-3 [--i:3] sm:flex-row sm:gap-4 lg:mt-10">
      <a href="tel:{{ site.phone | phoneE164 }}" data-umami-event="appel" data-umami-event-emplacement="heros" class="btn-primary w-full sm:w-auto">{{ iconPartial.icon("phone", class="h-5 w-5 shrink-0") }}Appeler&nbsp;le&nbsp;{{ site.phone | phoneDisplay }}</a>
      <a href="/contact/" class="btn-secondary w-full sm:w-auto">Me contacter</a>
    </div>
  </div>
</section>

{% set toc = content | headings %}
<div class="wrap grid gap-x-8 pt-(--section-gap-s) pb-(--section-gap) xl:grid-cols-12">
  <div class="prose-site xl:col-span-7">
    {{ content | safe }}
  </div>
  {% if toc.length >= 3 %}
  {% include "partials/toc.njk" %}
  {% endif %}
</div>

{% if faq %}
<section class="wrap pb-(--section-gap)" aria-labelledby="faq-title">
  <h2 id="faq-title" class="text-section">Questions fréquentes</h2>
  <div class="mt-10 border-b border-border lg:mt-14">
    {% for item in faq %}
    <div class="grid gap-3 border-t border-border py-8 lg:grid-cols-12 lg:gap-x-8 lg:py-10">
      <h3 class="text-title lg:col-span-5">{{ item.question }}</h3>
      <p class="text-body max-w-[64ch] lg:col-span-6 lg:col-start-7">{{ item.answer | safe }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% set related = [] %}
{% for project in projects %}
  {% if service in project.services and related.length < 3 %}
    {% set related = (related.push(project), related) %}
  {% endif %}
{% endfor %}

{% if related.length >= 2 %}
<section class="bg-paper-2 py-(--section-gap)" aria-labelledby="work-title">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h2 id="work-title" class="text-section">Des réalisations en ligne</h2>
      <a href="/portfolio/" class="tap"><span class="link-plain">Tout le portfolio</span></a>
    </div>

    <ul class="mt-10 grid list-none gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-14 {% if related.length == 3 %}lg:grid-cols-3{% endif %}">
      {% for project in related %}
      <li>
        <article>
          <a href="{{ project.url }}" target="_blank" rel="noopener" class="group relative block aspect-16/10 overflow-hidden rounded-2xl bg-paper ring-1 ring-border">
            {% if related.length == 3 %}{% set workSizes = "(min-width: 1440px) 416px, (min-width: 1024px) calc(33.33vw - 64px), (min-width: 960px) calc(50vw - 80px), (min-width: 640px) calc(50vw - 40px), calc(100vw - 32px)" %}{% else %}{% set workSizes = "(min-width: 1440px) 640px, (min-width: 960px) calc(50vw - 80px), (min-width: 640px) calc(50vw - 40px), calc(100vw - 32px)" %}{% endif %}
            {% responsiveImage project.image, project.imageAlt, { sizes: workSizes, className: "absolute inset-0 h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100" } %}
            <span class="sr-only">Voir le site {{ project.name }} (nouvel onglet)</span>
          </a>
          <h3 class="text-title mt-5">{{ project.name }}</h3>
          <p class="mt-1 flex flex-wrap gap-x-4 text-sm"><span class="text-copy">{{ project.tag }}</span>{% if project.stack %}<span class="text-muted">{{ project.stack }}</span>{% endif %}</p>
          <p class="mt-2">
            <a href="{{ project.url }}" target="_blank" rel="noopener" class="tap"><span class="link-plain">Voir le site<span class="sr-only"> {{ project.name }} (nouvel onglet)</span></span></a>
          </p>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<div class="deep on-dark">
  <section class="wrap pt-(--section-gap) pb-(--section-gap-s)" aria-labelledby="services-title">
    <h2 id="services-title" class="text-section text-foam">Les autres services</h2>
    <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-14 lg:gap-x-16 lg:gap-y-14">
      {% for item in services %}
      {% if item.key != service %}
      <div class="group relative flex flex-col border-t border-foam/25 pt-6 has-focus-visible:outline-2 has-focus-visible:outline-offset-4 has-focus-visible:outline-focus-light">
        <div class="flex items-center gap-4">
          {{ iconPartial.icon(item.icon, class="-ml-1.5 h-12 w-12 shrink-0 text-foam") }}
          <h3 class="text-title text-foam"><a href="{{ item.url }}" class="decoration-2 underline-offset-[0.2em] group-hover:underline after:absolute after:inset-0 focus-visible:outline-none">{{ item.title }}</a></h3>
        </div>
        <p class="text-body mt-4 max-w-[48ch]">{{ item.summary }}</p>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="relative isolate overflow-hidden pt-(--section-gap) pb-(--section-gap-l) text-center" aria-labelledby="cta-title">
    <div class="pointer-events-none absolute inset-0 -z-10 hidden select-none sm:block" aria-hidden="true">
      <div class="absolute bottom-0 left-0 text-ocean-deep lg:left-[6%]">
        {{ logoPartial.reuse("kelp-shape", size=520, class="h-[20rem] w-auto lg:h-[30rem]") }}
      </div>
      <div class="absolute right-0 bottom-0 -scale-x-100 text-ocean-deep opacity-70 lg:right-[8%]">
        {{ logoPartial.reuse("kelp-shape", size=520, class="h-[16rem] w-auto lg:h-[24rem]") }}
      </div>
    </div>
    <div class="wrap">
      <h2 id="cta-title" class="text-display mx-auto max-w-[18ch] text-foam">{{ cta.title }}</h2>
      <p class="text-lead mx-auto mt-6 max-w-[52ch]">{{ cta.text }}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:justify-center sm:gap-4">
        <a href="/contact/" class="btn-primary w-full sm:w-auto">Me contacter</a>
        <a href="tel:{{ site.phone | phoneE164 }}" data-umami-event="appel" data-umami-event-emplacement="cta" class="btn-secondary w-full sm:w-auto">Appeler&nbsp;le&nbsp;{{ site.phone | phoneDisplay }}</a>
      </div>
    </div>
  </section>
</div>
