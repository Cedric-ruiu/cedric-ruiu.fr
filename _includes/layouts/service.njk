---
layout: base
---
{% import "partials/icons.njk" as iconPartial %}

{# Background rhythm, same as the home page: sand (intro, body, FAQ) → tide band (projects, other services) → sand CTA → ink footer. #}
<section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
  <p class="eyebrow">{{ eyebrow }}</p>
  <h1 class="text-h1 mt-3 font-serif">{{ heading }}</h1>
  {# The direct answer to the page's question, 40–60 words: it is what a reader
     — and a search engine looking for a snippet — should get first. #}
  <p class="text-body mt-5">{{ lead }}</p>

  {# Call stays above the fold on a phone, one tap away: the audience is local
     and mostly mobile. No-break spaces keep the label on one line, as the
     number itself already is. #}
  <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
    <a href="/contact/" class="btn-primary w-full sm:w-auto">Me contacter</a>
    <a href="tel:{{ site.phone | phoneE164 }}" class="btn-secondary w-full sm:w-auto">Appeler&nbsp;le&nbsp;{{ site.phone | phoneDisplay }}</a>
  </div>
</section>

<div class="prose-site mx-auto max-w-3xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16 sm:pb-20">
  {{ content | safe }}
</div>

{% if faq %}
<section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-20" aria-labelledby="faq-title">
  <h2 id="faq-title" class="text-h2 font-serif">Questions fréquentes</h2>
  {# Always visible, never behind <details>: an answer hidden in an accordion is
     content a phone user may never see. #}
  <div class="mt-8 flex flex-col gap-8">
    {% for item in faq %}
    <div>
      <h3 class="text-h3 font-serif">{{ item.question }}</h3>
      <p class="text-body mt-3">{{ item.answer | safe }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# Projects tagged with this service in projects.yml, three at most — and only
   from two up: a lone card in a three-track grid reads as an empty shelf. #}
{% set related = [] %}
{% for project in projects %}
  {% if service in project.services and related.length < 3 %}
    {% set related = (related.push(project), related) %}
  {% endif %}
{% endfor %}

<section class="bg-tide">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    {% if related.length >= 2 %}
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <h2 class="text-h2 font-serif">Des réalisations en ligne</h2>
      <a href="/portfolio/" class="tap font-medium text-ocean"><span class="link-underline">Tout le portfolio <span aria-hidden="true">→</span></span></a>
    </div>

    <ul class="mt-8 grid list-none grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for project in related %}
      <li class="flex">
        <article class="card flex w-full flex-col overflow-hidden">
          {# Same negative focus offset as the portfolio cards: overflow-hidden would clip the ring. #}
          <a href="{{ project.url }}" target="_blank" rel="noopener" class="group relative block aspect-16/10 w-full overflow-hidden bg-tide focus-visible:-outline-offset-4 focus-visible:shadow-none">
            {# `sizes` mirrors the grid: max-w-6xl container, gap 1.5rem, 1/2/3 tracks. #}
            {% responsiveImage project.image, project.imageAlt, { sizes: "(min-width: 1152px) 21.7rem, (min-width: 1024px) calc((100vw - 7rem) / 3), (min-width: 640px) calc((100vw - 4.5rem) / 2), calc(100vw - 2rem)", className: "absolute inset-0 h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100" } %}
            <span class="sr-only">Voir le site {{ project.name }} (nouvel onglet)</span>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <span class="tag self-start">{{ project.tag }}</span>
            <h3 class="text-h3 mt-4 font-serif">{{ project.name }}</h3>
            {% if project.stack %}<p class="mt-2 text-sm text-muted">{{ project.stack }}</p>{% endif %}
            <p class="mt-auto pt-3">
              <a href="{{ project.url }}" target="_blank" rel="noopener" class="tap font-medium text-ocean">
                <span class="link-underline">Voir le site<span class="sr-only"> {{ project.name }} (nouvel onglet)</span>
                  <span aria-hidden="true">→</span></span>
              </a>
            </p>
          </div>
        </article>
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    <h2 class="text-h2 font-serif {% if related.length >= 2 %}mt-16{% endif %}">Les autres services</h2>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {% for item in services %}
      {% if item.key != service %}
      <a href="{{ item.url }}" class="card group flex items-start gap-5 p-6 transition-colors hover:border-ocean sm:p-7">
        {{ iconPartial.icon(item.icon, class="h-12 w-12 shrink-0 text-ocean") }}
        <span>
          <span class="block font-serif text-h3 font-bold text-ink group-hover:text-ocean">{{ item.title }}</span>
          <span class="text-body mt-2 block">{{ item.summary }}</span>
        </span>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
  <h2 class="text-h2 font-serif">{{ cta.title }}</h2>
  <p class="text-body mx-auto mt-4 max-w-xl">{{ cta.text }}</p>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center sm:gap-4">
    <a href="/contact/" class="btn-primary w-full sm:w-auto">Me contacter</a>
    <a href="tel:{{ site.phone | phoneE164 }}" class="btn-secondary w-full sm:w-auto">Appeler&nbsp;le&nbsp;{{ site.phone | phoneDisplay }}</a>
  </div>
</section>
